HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgres://devsentinel:devsentinel@127.0.0.1:54329/devsentinel
REDIS_URL=redis://127.0.0.1:63799
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
AUTHORIZATION_MODE=development-allow-all
LOG_LEVEL=info

# Local learning mode runs the harmless fixture through the real Docker
# sandbox. In live GitHub App mode, switch this to github-app so DevSentinel
# resolves and downloads the repository's exact commit.
REPOSITORY_SOURCE_MODE=local
LOCAL_REPOSITORY_PATH=fixtures/sandbox/passing-node

# Each repository gets fresh install and test containers. The test container
# has no network. Timeouts are wall-clock milliseconds; logs are bounded.
SANDBOX_DOCKER_IMAGE=node:22.23.2-bookworm-slim
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_MB=1024
SANDBOX_PIDS_LIMIT=256
SANDBOX_INSTALL_TIMEOUT_MS=300000
SANDBOX_TEST_TIMEOUT_MS=300000
SANDBOX_OUTPUT_LIMIT_KB=256
BASELINE_WORKER_CONCURRENCY=1

# Replace AUTHORIZATION_MODE above with github-app for live authorization, then
# configure the values below. Keep the downloaded PEM inside the ignored
# .secrets directory; never paste the private key into source control.
# AUTHORIZATION_MODE=github-app
# REPOSITORY_SOURCE_MODE=github-app
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY_PATH=.secrets/devsentinel.private-key.pem
# GITHUB_API_URL=https://api.github.com
# GITHUB_API_VERSION=2026-03-10
# GITHUB_TEST_MINIMUM_PERMISSION=write
# GITHUB_FIX_MINIMUM_PERMISSION=write

# Repair and GitHub delivery are opt-in. Enable only repositories whose source
# you approve sending to the configured model provider (comma-separated names).
AGENT_ALLOWED_REPOSITORIES=
AGENT_MODEL_PROVIDER=disabled
# OPENAI_API_KEY=...
# OPENAI_MODEL=<a model available to your API account that supports Structured Outputs>
AGENT_MAX_ATTEMPTS=3
AGENT_MAX_TOKENS=200000
AGENT_MAX_OUTPUT_TOKENS=4096
AGENT_MAX_MODEL_TURNS=4
AGENT_MAX_TOOL_CALLS=24
AGENT_MAX_TOOL_OUTPUT_KB=16
# Optional model-specific rates. One USD = 1,000,000 micro-USD. When omitted,
# estimated cost is honestly shown as unknown rather than inferred from stale pricing.
# AGENT_INPUT_COST_MICROUSD_PER_MILLION=1000000
# AGENT_OUTPUT_COST_MICROUSD_PER_MILLION=4000000
AGENT_CLARIFICATION_TTL_MS=172800000
# Requires a captured-revision .devsentinel.json that also enables and scopes it.
AGENT_ALLOW_REGRESSION_TESTS=false
AGENT_MAX_DURATION_MS=900000
AGENT_MODEL_TIMEOUT_MS=120000

# dry-run stores a report locally and performs no GitHub writes.
# github-app additionally requires Contents, Issues, Pull requests, Checks: write.
GITHUB_DELIVERY_MODE=dry-run

# Generate with openssl rand -hex 32. Separate from the webhook secret.
# When unset, /ops is disabled. /dashboard contains no data until authenticated.
# CONTROL_API_TOKEN=<random-token-at-least-32-characters>

# The run inspector is read-only and has a separate durable query/token budget.
# Its deterministic evidence fallback works while the provider is disabled.
INSPECTOR_MODEL_PROVIDER=disabled
# INSPECTOR_MODEL=<a small Responses API model>
INSPECTOR_MAX_QUERIES=20
INSPECTOR_MAX_TOKENS=50000
INSPECTOR_MAX_OUTPUT_TOKENS=800
INSPECTOR_TIMEOUT_MS=30000
